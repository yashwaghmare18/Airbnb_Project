<style>
  .search button {
    border-radius: 2rem;
  }

  .search input {
    border-radius: 2rem;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }

  .search input::placeholder {
    text-align: center;
  }

  .search i {
    display: inline;
    margin-right: 0.5rem;
  }

  @media(max-width : 767px) {
    .offcanvas-body ul {
      align-items: flex-start !important;
    }

    .search {
      order: -1;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-tertiary fixed-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Wanderlust</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav justify-content-between align-items-center flex-grow-1 pe-3">
          <li class="nav-item">
            <a class="nav-link" href="/listings">Explore</a>
          </li>
        
          <li class="nav-item search">
            <div class="navbar-nav">
              <form method="get" action="/search" class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Search Destination" name="country[name]" />
                <button class="btn btn-outline-danger" type="submit">
                  <i class="fa-solid fa-magnifying-glass"></i>Search
                </button>
              </form>
            </div>
          </li>

          <li class="nav-item">
            <div class="navbar-nav" style="font-style: italic">
              <a class="nav-link" href="/listings/new">Add New Listing</a>
              <% if(!currentUser){ %>
                <a class="nav-link" href="/signup">Sign Up</a>
                <a class="nav-link" href="/login">Login</a>
                <% } %>
                  <% if(currentUser){ %>
                    <a class="nav-link" href="/logout">Log Out</a>
                    <% } %>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
      <div class="navbar-nav" style="font-style: italic">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav search">
        <form method="get" action="/search" class="d-flex" role="search">
          <input class="form-control me-2" type="search" placeholder="Search Destination" name="country[name]" />
          <button class="btn btn-outline-danger" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

      <div class="navbar-nav" style="font-style: italic">
        <a class="nav-link" href="/listings/new">Add New Listing</a>
        <% if(!currentUser){ %>
          <a class="nav-link" href="/signup">Sign Up</a>
          <a class="nav-link" href="/login">Login</a>
          <% } %>
            <% if(currentUser){ %>
              <a class="nav-link" href="/logout">Log Out</a>
              <% } %>
      </div>
    </div>
  </div>
</nav>