<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
        <h3 class="mt-3 mb-3">SignUp With Wonderlust</h3>

        <form method="post" action="/signup" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-lable mb-1">Username : </label>
                <input class="form-control" type="text" name="username" id="username" required>
                <div class="invalid-feedback">
                    Username should be valid.
                </div>
                <div class="valid-feedback">
                    Looks Good.
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-lable mb-1">Email : </label>
                <input class="form-control" type="email" name="email" id="email" required>
                <div class="invalid-feedback">
                    Email should be valid.
                </div>
                <div class="valid-feedback">
                    Looks Good.
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-lable mb-1">Password : </label>
                <input class="form-control" type="password" name="password" id="password" required>
                <div class="invalid-feedback">
                    Password should be valid.
                </div>
                <div class="valid-feedback">
                    Looks Good.
                </div>
            </div>

            <button class="btn btn-outline-success mb-3">Sign Up</button>
        </form>
    </div>
</div>