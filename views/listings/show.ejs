<% layout("/layouts/boilerplate") %>

  <body>
    <div class="row">
      <div class="card col-lg-8 offset-lg-2">
        <h3 class="mt-3 mb-3">
          <%= listing.title %>
        </h3>
        <img src="<%= listing.image.url %>" class="card-img-to card-img" alt="Listing Image" style="height: 30rem" />

        <p class="card-text mt-3">
          <i>Owned By : <%= listing.owner.username %></i><br />
          <%= listing.description %><br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %><br />
              <%= listing.location %><br />
                <%= listing.country %>
        </p>

        <% if(currentUser && currentUser._id.equals(listing.owner._id)){ %>
          <div class="btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-success mb-3">Edit</a>

            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-outline-danger mb-3 offset-4">Delete</button>
            </form>
          </div>
          <% } %>

            <div class="mt-3">
              <% if(currentUser){ %>
                <form method="get" action="/listings/<%= listing.id %>/reviews">
                  <button class="btn btn-outline-dark mb-3">Leave a Review</button>
                </form>
                <% } %>
            </div>

            <hr />
            
            <% if(listing.reviews.length > 0 ){ %>
            <div class="row">
              <h4>All Reviews</h4>
              <% for(review of listing.reviews){ %>
                <div class="card col-sm-5 bg-light text-secondary me-4" >
                  <div class="card-body">
                    <h5 class="card-title">@<%= review.author.username %></h5>

                    <p class="card-text starability-result" data-rating="<%= review.rating %>"></p>

                    <p> <%= review.createdAt.toString().split(" ").slice(0, 4).join(" ") %></p>

                    <p class=" card-text"><%= review.comment %></p>

                    <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-outline-dark mb-3">Delete</button>
                    </form>
                  </div>
                </div>
                <% } %>
            </div>
            <% } %>

      </div>
    </div>
  </body>