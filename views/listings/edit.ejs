<% layout("/layouts/boilerplate") %>
  <style>
    .preview img {
      width: 250px;
      height: 167px;
    }
  </style>

  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="mt-3 mb-3">Edit Your Listing</h3>
      <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate
        enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-lable mb-1">Title : </label>
          <input class="form-control" type="text" value="<%= listing.title %>" name="listing[title]" required />
          <div class="invalid-feedback">Title should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-lable mb-1">Description : </label>
          <textarea class="form-control" name="listing[description]" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Description should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <div class="mb-3 preview">
          <p>Current Image :</p>
          <img src="<%= originalUrl %>" />
        </div>

        <div class="mb-3">
          <label for="image" class="form-lable mb-1">Image : </label>
          <input class="form-control" type="file" name="listing[image]" />
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lable mb-1">Price : </label>
            <input class="form-control" type="text" value="<%= listing.price %>" name="listing[price]" required />
            <div class="invalid-feedback">Price should be valid.</div>
            <div class="valid-feedback">Looks Good.</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="location" class="form-lable mb-1">Location : </label>
            <input class="form-control" type="text" value="<%= listing.location %>" name="listing[location]" required />
            <div class="invalid-feedback">Location should be valid.</div>
            <div class="valid-feedback">Looks Good.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="country" class="form-lable mb-1">Country : </label>
          <input class="form-control" type="text" value="<%= listing.country %>" name="listing[country]" required />
          <div class="invalid-feedback">Country should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <button class="btn btn-outline-success mb-3 col-3">Edit</button>
      </form>
    </div>
  </div>