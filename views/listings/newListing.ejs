<% layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="mb-3 mt-3">Add a new Listing</h3>
      <form
        method="post"
        action="/listings"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-lable mb-1">Title : </label>
          <input
            class="form-control"
            type="text"
            placeholder="Enter title"
            name="listing[title]"
            required
          />
          <div class="invalid-feedback">Title should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-lable mb-1"
            >Description :
          </label>
          <textarea
            class="form-control"
            placeholder="Enter description"
            name="listing[description]"
            required
          ></textarea>
          <div class="invalid-feedback">Description should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-lable mb-1">Upload Image : </label>
          <input class="form-control" type="file" name="listing[image]" required/>
          <div class="invalid-feedback">Image should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lable mb-1">Price : </label>
            <input
              class="form-control"
              type="text"
              placeholder="&#8377;15,000"
              name="listing[price]"
              required
            />
            <div class="invalid-feedback">Price should be valid.</div>
            <div class="valid-feedback">Looks Good.</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="location" class="form-lable mb-1">Location : </label>
            <input
              class="form-control"
              type="text"
              placeholder="Near Goa"
              name="listing[location]"
              required
            />
            <div class="invalid-feedback">Location should be valid.</div>
            <div class="valid-feedback">Looks Good.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="country" class="form-lable mb-1">Country : </label>
          <input
            class="form-control"
            type="text"
            placeholder="India"
            name="listing[country]"
            required
          />
          <div class="invalid-feedback">Country should be valid.</div>
          <div class="valid-feedback">Looks Good.</div>
        </div>

        <button class="btn btn-outline-primary mb-3">Add</button>
      </form>
    </div>
  </div>
</body>
