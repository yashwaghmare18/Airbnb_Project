<% layout("/layouts/boilerplate") %>
<body>
    <div class="row row-cols-sm-8 offset-sm-2 mt-3">
        <div class="col">
        <h4>Leave a Review</h4>
        <form method="post" action="/listings/<%= listing.id %>/reviews" class="needs-validation" novalidate>
            <div class="mt-3">
                <fieldset class="starability-heart">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="rate1" name="review[rating]" value="1" />
                    <label for="rate1">1 star.</label>

                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                    <label for="rate2">2 stars.</label>

                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                    <label for="rate3">3 stars.</label>

                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                    <label for="rate4">4 stars.</label>

                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                    <label for="rate5">5 stars.</label>

                    <span class="starability-focus-ring"></span>
                </fieldset>
            </div>

            <div class="mb-3">
                <label class="form-lable" for="comment">Comment</label>
                <textarea class="form-control" name="review[comment]" id="comment" rows="5" required></textarea>
                <div class="invalid-feedback">Comment should be valid.</div>
                <div class="valid-feedback">Looks Good.</div>
            </div>

            <button class="btn btn-outline-dark mb-3">Submit</button>
        </form>
    </div>
</div>
</body>